{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Dependency update pull requests, opened by this repository's own workflow — and merged by
  // it, without a human in the loop.
  //
  // Read `.github/workflows/renovate.yml` alongside this: it holds the reasoning for running
  // self-hosted, for the token, and for the second job that re-pins the digest files an action
  // bump invalidates. `.github/renovate.md` is the setup the maintainer has to do once.
  //
  // NOT at the repository root, where Renovate also looks. `.agents/rules/root-additions-policy.md`
  // asks for approval before an agent adds a root file, and `.github/` is one of the sanctioned
  // locations Renovate searches.

  extends: [
    "config:recommended",
    // Group what moves together, so one review covers one decision instead of five.
    "group:monorepos",
    "group:recommended",
    // Actions arrive as a SHA plus a version comment, which is the form this tree already uses
    // and the form `check-workflow-hygiene.mjs`'s `action-pin` rule requires.
    "helpers:pinGitHubActionDigests",
  ],

  timezone: "Asia/Tokyo",
  schedule: ["before 6am on monday"],

  // ── Automerge: every update type, major included ─────────────────────────────────────────────
  //
  // The merge condition is CI and nothing else. That is a deliberate trade and it is only sound
  // because of what CI here IS: `ci-pass` aggregates every lane — lint, both type lanes, the Node
  // floor, the full Vitest set, scanner coverage and the packaged-build verification — and its
  // accepting set rejects any job result that is not `success` or `skipped`. A dependency that
  // breaks this repository fails that verdict, so the pull request does not merge; a dependency
  // that does not, merges without anyone reading it.
  //
  // Set at the TOP LEVEL rather than through `matchUpdateTypes`, which is how the common
  // "everything but major" policy is spelled. Major bumps are in scope here on purpose.
  automerge: true,
  automergeType: "pr",
  // Platform-native automerge — GitHub merges the moment the required checks pass, rather than
  // Renovate merging on its next run. With the weekly schedule above, Renovate-side automerge
  // would park a green pull request for up to a week; this is not a preference but the
  // difference between the policy working and the policy reading as if it worked.
  platformAutomerge: true,
  // STATED rather than left to its default, because it is the one knob that would quietly undo
  // the whole block: `true` merges a branch whose checks failed.
  ignoreTests: false,
  // Deliberately unconstrained, and NOT copied from `schedule` above. That one holds branch
  // creation to Monday morning; a merge happens when CI goes green, which is a different moment,
  // and pinning the two together would hold a finished pull request until the next window.
  automergeSchedule: ["at any time"],
  //
  // ⚠ Load-bearing repository SETTING, which no file here can assert: branch protection on the
  // default branch must require the `ci-pass` status check. With `platformAutomerge` on and no
  // required check configured, GitHub merges a pull request whose checks never ran — the exact
  // failure this whole block is otherwise built to avoid. `.github/required-status-contexts.json`
  // is where that expectation is declared and argued; `.github/renovate.md` repeats it as the
  // second thing a maintainer has to do once.

  // A ceiling, not a target — and one that now has to be able to DRAIN. The old limits (5 open,
  // 2 per hour) were sized against a human reading the queue, and the argument for them was that
  // an unread update pull request is worse than none. Nothing reads this queue any more, so the
  // ceiling that remains is about CI concurrency rather than attention: a backlog that can only
  // clear at five per week is a policy that says "automerge" and behaves like a slow manual one.
  prConcurrentLimit: 10,
  prHourlyLimit: 5,

  labels: ["dependencies"],

  // `chore(deps): …`, built from the two fields rather than from `commitMessagePrefix`, which
  // would override the semantic prefix and give two ways to spell one thing.
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",

  // The identity the `repin` job also commits under. Renovate decides whether a branch was edited
  // by hand by comparing its commits against this, and it stops updating a branch it believes
  // someone else has touched — so a re-pin under any other name would freeze exactly the branches
  // it had just fixed. Stated here rather than left to default, which resolves to whatever user
  // the token belongs to and would make a real hand edit by that user invisible.
  gitAuthor: "renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",

  // Never a version the ecosystem published minutes ago: three days is enough for an unpublish or
  // a fast follow-up to land first.
  minimumReleaseAge: "3 days",

  // The lockfile is checked in and CI installs with `--frozen-lockfile`, so an update that leaves
  // it stale fails every lane.
  postUpdateOptions: ["pnpmDedupe"],

  packageRules: [
    {
      // The shipped workflows under `assets/init/root/.github/workflows/**` are what `qfai init`
      // writes into an adopter's repository. They move with this repository's own — an adopter
      // should not inherit a deprecation the maintainers already fixed for themselves — so they
      // are grouped with it rather than updated on a schedule of their own.
      matchManagers: ["github-actions"],
      matchFileNames: [
        ".github/workflows/**",
        ".github/actions/**",
        "packages/qfai/assets/init/root/.github/workflows/**",
      ],
      groupName: "github actions",
    },
    {
      // A toolchain floor still gets its OWN pull request. Raising `engines.node` changes what
      // the published package promises its users and `packageManager` changes what every lane
      // runs, so neither rides along inside a group where the diff that matters is one line among
      // twenty.
      //
      // What it no longer gets is a hold. `dependencyDashboardApproval: true` used to sit here and
      // opened nothing until someone ticked a box on the dashboard; the policy above is that CI is
      // the gate, and these two are the changes CI is most able to judge — the Node floor is
      // verified by the `node-floor` lane against the declared `engines` range, and a
      // `packageManager` bump is executed by every job in the tree before anything else runs.
      matchDepTypes: ["engines", "packageManager"],
      groupName: null,
    },
  ],

  customManagers: [
    {
      // Renovate's own version, which it cannot see by itself: the `github-actions` manager reads
      // `uses:` lines and the `node-version` inputs of three `actions/setup-*` actions, and
      // `renovate-version` is none of those. Without this the pin in the workflow is the one
      // version in this tree that nothing keeps current.
      customType: "regex",
      managerFilePatterns: [".github/workflows/renovate.yml"],
      matchStrings: ["renovate-version:\\s*(?<currentValue>\\S+)"],
      depNameTemplate: "renovate",
      datasourceTemplate: "npm",
    },
  ],

  // One issue listing everything in flight. It no longer lists a queue WAITING on anybody — with
  // nothing held back for approval, what it shows is what is open and what has been detected — and
  // it stays on for exactly that: it is the one place to look when a dependency you expected to
  // move has not moved.
  dependencyDashboard: true,
  dependencyDashboardTitle: "Dependency dashboard",

  vulnerabilityAlerts: {
    // A known-exploitable advisory does not wait for Monday, and does not wait three days for the
    // fix to settle either. Automerge is INHERITED from the top level rather than restated: this
    // block lists what differs from the ordinary path, and a security fix merging on a green CI
    // run is the ordinary path, reached sooner.
    labels: ["dependencies", "security"],
    schedule: null,
    minimumReleaseAge: null,
    prCreation: "immediate",
  },
}
