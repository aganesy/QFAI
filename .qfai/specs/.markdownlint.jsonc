{
  // spec packs contain decision-record paragraphs, embedded YAML/JSON blocks,
  // and generator-produced tables that routinely exceed normal markdown
  // heuristics. The rules disabled below are regression sources, not quality
  // gates, for this directory only. Other projects and repo-root markdown are
  // still covered by the top-level .markdownlint-cli2.jsonc config.
  //
  // Resolution: `markdownlint-cli2` merges a per-directory `.markdownlint.jsonc`
  // with the nearest `.markdownlint-cli2.jsonc` up-tree, so running
  // `pnpm lint:md` (which invokes `markdownlint-cli2 "**/*.md"`) from the repo
  // root picks up this file automatically for every file under `.qfai/specs/`.
  // A regression guard lives in
  // `packages/qfai/tests/integration/specsMarkdownlintConfig.test.ts` — it
  // writes a synthetic over-length line under `.qfai/specs/spec-XXXX/` and
  // confirms lint stays green, proving this file is being applied. If that
  // test fails, the nested-config loading has been broken and this block is
  // no longer active.
  //
  // Kept ON (inherited): MD009, MD010, MD011, MD014, MD018-MD022, MD025-MD028,
  // MD031, MD035-MD040, MD042-MD046, MD048-MD055 (heading anchors, list hygiene,
  // code fence hygiene, link text validity).

  // Long lines: spec decisions cite external designs / commands verbatim.
  "MD013": false,
  // Heading increment: auto-generated audit sections sometimes skip levels.
  "MD001": false,
  // Multiple blank lines: tolerated in generated tables/lists for readability.
  "MD012": false,
  // Duplicate headings: DR-ID / OQ-ID revision suffixes reuse base titles.
  "MD024": false,
  // Blanks around lists: generator output interleaves lists with prose.
  "MD032": false,
  // Inline HTML: rare `<n>` / `<id>` / `<skill>` placeholders in examples —
  // allow-list just those so the lint still flags unintended HTML tags.
  "MD033": { "allowed_elements": ["n", "id", "skill"] },
  // Bare URLs: test-case examples include raw http://localhost URLs.
  "MD034": false,
  // MD047 (trailing newline) intentionally left ON: authored files must end
  // with a newline; generator output that previously tripped this rule has
  // been corrected at source (see spec-0012 tail-append fixup).
  // Table column count: some cells embed pipe characters inside code spans.
  "MD056": false,
}
