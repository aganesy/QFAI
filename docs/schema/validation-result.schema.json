{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QFAI ValidationResult",
  "type": "object",
  "required": ["toolVersion", "issues", "counts", "traceability"],
  "properties": {
    "toolVersion": { "type": "string" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "category", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "enum": ["info", "warning", "error"] },
          "category": { "enum": ["compatibility", "change"] },
          "message": { "type": "string" },
          "suggested_action": { "type": "string" },
          "file": { "type": "string" },
          "dl_id": { "type": "string" },
          "rule": { "type": "string" },
          "refs": { "type": "array", "items": { "type": "string" } },
          "loc": {
            "type": "object",
            "required": ["line"],
            "properties": {
              "line": { "type": "integer", "minimum": 1 },
              "column": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "required": ["info", "warning", "error"],
      "properties": {
        "info": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "traceability": {
      "type": "object",
      "required": ["sc", "testFiles"],
      "properties": {
        "sc": {
          "type": "object",
          "required": ["total", "covered", "missing", "missingIds", "refs"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "covered": { "type": "integer", "minimum": 0 },
            "missing": { "type": "integer", "minimum": 0 },
            "missingIds": { "type": "array", "items": { "type": "string" } },
            "refs": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "additionalProperties": false
        },
        "testFiles": {
          "type": "object",
          "required": ["globs", "excludeGlobs", "matchedFileCount", "truncated", "limit"],
          "properties": {
            "globs": { "type": "array", "items": { "type": "string" } },
            "excludeGlobs": { "type": "array", "items": { "type": "string" } },
            "matchedFileCount": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" },
            "limit": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "waivers": {
      "type": "object",
      "required": ["active", "suppressed"],
      "properties": {
        "active": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "rule_id", "action", "reason", "expires_on"],
            "properties": {
              "id": { "type": "string" },
              "rule_id": { "type": "string" },
              "action": { "enum": ["suppress", "downgrade"] },
              "downgrade_to": { "enum": ["Info"] },
              "match": {
                "type": "object",
                "properties": {
                  "dl_ids": { "type": "array", "items": { "type": "string" } },
                  "paths": { "type": "array", "items": { "type": "string" } }
                },
                "additionalProperties": false
              },
              "reason": { "type": "string" },
              "expires_on": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "owner": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "suppressed": {
          "type": "object",
          "required": ["total", "byWaiver", "byRule"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "byWaiver": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            },
            "byRule": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
