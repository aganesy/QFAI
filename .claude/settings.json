{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "QFAI structured-question reminder",
            "command": "node",
            "args": [
              "-e",
              "try{let p;try{p=JSON.parse(require('fs').readFileSync(0,'utf8')).prompt}catch{}if(!(typeof p==='string'&&/^[ \\t]*<(task-notification|wake)[\\s>]/m.test(p))){const m=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'))[process.argv[2]];if(m!==undefined)console.log(JSON.stringify(m))}}catch{}",
              "${CLAUDE_PROJECT_DIR}/.agents/rules/reminders.json",
              "structured-question"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request|issue_write|add_issue_comment|pull_request_review_write|add_comment_to_pending_review|add_reply_to_pull_request_comment)",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "QFAI documentation-clarity reminder",
            "command": "node",
            "args": [
              "-e",
              "try{const m=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'))[process.argv[2]];if(m!==undefined)console.log(JSON.stringify(m))}catch{}",
              "${CLAUDE_PROJECT_DIR}/.agents/rules/reminders.json",
              "documentation-clarity-before-post"
            ]
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "QFAI grilling reminder: design artifact",
            "command": "node",
            "args": [
              "-e",
              "try{const m=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'))[process.argv[2]];if(m!==undefined)console.log(JSON.stringify(m))}catch{}",
              "${CLAUDE_PROJECT_DIR}/.agents/rules/reminders.json",
              "grilling-design-artifact"
            ]
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "QFAI grilling reminder: delegation",
            "command": "node",
            "args": [
              "-e",
              "try{const m=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'))[process.argv[2]];if(m!==undefined)console.log(JSON.stringify(m))}catch{}",
              "${CLAUDE_PROJECT_DIR}/.agents/rules/reminders.json",
              "grilling-delegation"
            ]
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "QFAI grilling reminder: plan",
            "command": "node",
            "args": [
              "-e",
              "try{const m=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'))[process.argv[2]];if(m!==undefined)console.log(JSON.stringify(m))}catch{}",
              "${CLAUDE_PROJECT_DIR}/.agents/rules/reminders.json",
              "grilling-plan"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "QFAI api-budget reminder",
            "command": "node",
            "args": [
              "-e",
              "try{const c=JSON.parse(require('fs').readFileSync(0,'utf8')).tool_input.command;if(typeof c==='string'&&/(^|[^\\w.-])gh([^\\w.-]|$)|api\\.github\\.com/.test(c)){const m=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'))[process.argv[2]];if(m!==undefined)console.log(JSON.stringify(m))}}catch{}",
              "${CLAUDE_PROJECT_DIR}/.agents/rules/reminders.json",
              "api-budget"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/*.md)",
            "statusMessage": "QFAI documentation-clarity reminder",
            "command": "node",
            "args": [
              "-e",
              "try{const m=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'))[process.argv[2]];if(m!==undefined)console.log(JSON.stringify(m))}catch{}",
              "${CLAUDE_PROJECT_DIR}/.agents/rules/reminders.json",
              "documentation-clarity-after-write"
            ]
          },
          {
            "type": "command",
            "if": "Edit(**/*.md)",
            "statusMessage": "QFAI documentation-clarity reminder",
            "command": "node",
            "args": [
              "-e",
              "try{const m=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'))[process.argv[2]];if(m!==undefined)console.log(JSON.stringify(m))}catch{}",
              "${CLAUDE_PROJECT_DIR}/.agents/rules/reminders.json",
              "documentation-clarity-after-edit"
            ]
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "QFAI minimal-implementation reminder",
            "command": "node",
            "args": [
              "-e",
              "try{const m=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'))[process.argv[2]];if(m!==undefined)console.log(JSON.stringify(m))}catch{}",
              "${CLAUDE_PROJECT_DIR}/.agents/rules/reminders.json",
              "minimal-implementation"
            ]
          }
        ]
      }
    ]
  }
}
