{
  "name": "qfai",
  "version": "1.10.1",
  "description": "Quality-first AI-driven development toolkit (SDD × ATDD × TDD).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aganesy/QFAI.git"
  },
  "bugs": {
    "url": "https://github.com/aganesy/QFAI/issues"
  },
  "homepage": "https://github.com/aganesy/QFAI#readme",
  "type": "module",
  "bin": {
    "qfai": "dist/cli/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "lint": "eslint src",
    "lint:branch-version": "bash scripts/check-branch-version-pin.sh",
    "lint:shipping": "vitest run tests/scripts/lintShipping.test.ts",
    "lint:workflow-shape": "vitest run tests/integration/shippedWorkflowShapeGate.test.ts",
    "lint:mirror-surface": "vitest run tests/integration/agentsRulesSurface.test.ts tests/integration/skillLinkSurface.test.ts tests/core/integrationSurface.test.ts tests/core/integrationSurfaceReadErrors.test.ts tests/assets/reviewerVerdictVocabulary.test.ts tests/codex/agents.test.ts tests/core/prFixMonitor.test.ts tests/core/prMergePlan.test.ts",
    "generate:rule-codes": "node scripts/generate-emitted-rule-codes.mjs",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage tests/unit/core/prototyping tests/core/prototyping",
    "test:core": "vitest run --project core",
    "test:validators": "vitest run --project validators",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:cli": "vitest run --project cli",
    "test:unit": "vitest run --project unit",
    "test:scripts": "vitest run --project scripts",
    "test:assets": "vitest run tests/assets",
    "self-validate": "node dist/cli/index.mjs validate --profile tdd --fail-on error --root ../.."
  },
  "dependencies": {
    "@cucumber/gherkin": "^37.0.1",
    "@cucumber/messages": "^31.1.0",
    "fast-glob": "^3.3.2",
    "jsdom": "^29.1.1",
    "yaml": "^2.5.1"
  },
  "optionalDependencies": {
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.19.39",
    "@vitest/coverage-v8": "^2.1.8",
    "smol-toml": "^1.6.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
