{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qfai:workflow:extraction",
  "title": "Request extraction",
  "description": "The facts `npx qfai workflow plan --in` reads out of a request, each from a closed vocabulary. It names no route, stage or step. Alternatives are required at low confidence, allowed at medium and refused at high.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "entryFlags",
    "qualifiers",
    "signals",
    "risks",
    "gate",
    "artifacts",
    "confidence"
  ],
  "properties": {
    "intent": {
      "description": "What the request asks for, or null when it cannot be read.",
      "enum": [
        "question-how",
        "question-why",
        "question-help",
        "question-hosted",
        "no-work",
        "defect",
        "defect-regression",
        "defect-silent",
        "defect-crash",
        "defect-conformance",
        "performance",
        "security",
        "surface-contradiction",
        "model-gap",
        "unenforced",
        "stale-record",
        "feature",
        "design",
        "epic",
        "behaviour-change",
        "deprecation",
        "refactor",
        "docs",
        "flaky-test",
        "test-defect",
        "ci",
        "dependency",
        "release",
        "order",
        "follow-up",
        null
      ]
    },
    "entryFlags": {
      "type": "array",
      "items": {
        "enum": [
          "repro",
          "cause",
          "fix",
          "expect",
          "decision",
          "upstream",
          "bundle",
          "vague",
          "last-good",
          "env",
          "intermittent",
          "trace",
          "bot",
          "measured",
          "stale"
        ]
      }
    },
    "qualifiers": {
      "type": "array",
      "items": {
        "enum": [
          "docs-answerable",
          "known-duplicate",
          "mixed-bundle",
          "human-run",
          "distribution-incident",
          "settled-design",
          "red-since-change",
          "check-misses",
          "mechanism-inert",
          "removal-requested",
          "visual-open",
          "contradicts-record"
        ]
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "enum": [
          "approved-record-task",
          "grilling-required",
          "decide-by-change-request",
          "disabled-test",
          "flaky-label",
          "backport",
          "release-notes",
          "test-plan"
        ]
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "enum": ["security", "data-loss", "silent", "breaking", "upgrade", "performance"]
      }
    },
    "gate": {
      "enum": ["none", "decide", "approve", "external"]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "enum": [
          "code",
          "tests",
          "spec",
          "contract",
          "ui",
          "docs",
          "config",
          "ci",
          "deps",
          "data",
          "release",
          "assistant"
        ]
      }
    },
    "confidence": {
      "enum": ["high", "medium", "low"]
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/reading"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["confidence"],
        "properties": {
          "confidence": {
            "const": "high"
          }
        }
      },
      "then": {
        "not": {
          "required": ["alternatives"],
          "properties": {
            "alternatives": true
          }
        }
      }
    },
    {
      "if": {
        "required": ["confidence"],
        "properties": {
          "confidence": {
            "const": "low"
          }
        }
      },
      "then": {
        "required": ["alternatives"],
        "properties": {
          "alternatives": true
        }
      }
    }
  ],
  "$defs": {
    "reading": {
      "description": "One further reading of the request.",
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "entryFlags", "qualifiers", "signals"],
      "properties": {
        "intent": {
          "description": "What the request asks for, or null when it cannot be read.",
          "enum": [
            "question-how",
            "question-why",
            "question-help",
            "question-hosted",
            "no-work",
            "defect",
            "defect-regression",
            "defect-silent",
            "defect-crash",
            "defect-conformance",
            "performance",
            "security",
            "surface-contradiction",
            "model-gap",
            "unenforced",
            "stale-record",
            "feature",
            "design",
            "epic",
            "behaviour-change",
            "deprecation",
            "refactor",
            "docs",
            "flaky-test",
            "test-defect",
            "ci",
            "dependency",
            "release",
            "order",
            "follow-up",
            null
          ]
        },
        "entryFlags": {
          "type": "array",
          "items": {
            "enum": [
              "repro",
              "cause",
              "fix",
              "expect",
              "decision",
              "upstream",
              "bundle",
              "vague",
              "last-good",
              "env",
              "intermittent",
              "trace",
              "bot",
              "measured",
              "stale"
            ]
          }
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "enum": [
              "docs-answerable",
              "known-duplicate",
              "mixed-bundle",
              "human-run",
              "distribution-incident",
              "settled-design",
              "red-since-change",
              "check-misses",
              "mechanism-inert",
              "removal-requested",
              "visual-open",
              "contradicts-record"
            ]
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "enum": [
              "approved-record-task",
              "grilling-required",
              "decide-by-change-request",
              "disabled-test",
              "flaky-label",
              "backport",
              "release-notes",
              "test-plan"
            ]
          }
        }
      }
    }
  }
}
