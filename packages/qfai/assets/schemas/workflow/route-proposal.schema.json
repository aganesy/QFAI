{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qfai:workflow:route-proposal",
  "title": "Route proposal",
  "description": "The proposal a routing result carries: the request kind, the facts the decision rules read, and what the route needs. It names no route.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestKind",
    "extraction",
    "goal",
    "expectedBehaviorRefs",
    "observedRefs",
    "affectedFlowIds",
    "riskSignals",
    "unresolvedQuestions",
    "newStories",
    "proposedWriteScope",
    "protectedTargets",
    "rationale"
  ],
  "properties": {
    "requestKind": {
      "description": "Only a routed request takes a route.",
      "enum": ["routed", "verify_only", "resume", "cancel", "explicit_stage"]
    },
    "extraction": {
      "$ref": "#/$defs/extraction"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "expectedBehaviorRefs": {
      "description": "Normative references.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/normativeReference"
      }
    },
    "observedRefs": {
      "description": "Observed references, kept apart from the normative ones.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/observedReference"
      }
    },
    "affectedFlowIds": {
      "description": "Business-flow IDs.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^BF-\\d{4}$"
      }
    },
    "riskSignals": {
      "type": "array",
      "items": {
        "enum": [
          "data-loss",
          "breaking-public-contract",
          "authorization-loosened",
          "authorization-restored",
          "secret-egress",
          "production-effect",
          "requirement-dropped",
          "out-of-scope-work"
        ]
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "newStories": {
      "description": "Each story the plan needs and no existing story represents.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["goal", "covers", "excludes", "evidence", "flowId"],
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excludes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "flowId": {
            "description": "The flow the story joins, or null for a new flow.",
            "oneOf": [
              {
                "type": "string",
                "pattern": "^BF-\\d{4}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "proposedWriteScope": {
      "description": "Project-relative paths or globs.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protectedTargets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "reading": {
      "description": "One further reading of the request.",
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "entryFlags", "qualifiers", "signals"],
      "properties": {
        "intent": {
          "description": "What the request asks for, or null when it cannot be read.",
          "enum": [
            "question-how",
            "question-why",
            "question-help",
            "question-hosted",
            "no-work",
            "defect",
            "defect-regression",
            "defect-silent",
            "defect-crash",
            "defect-conformance",
            "performance",
            "security",
            "surface-contradiction",
            "model-gap",
            "unenforced",
            "stale-record",
            "feature",
            "design",
            "epic",
            "behaviour-change",
            "deprecation",
            "refactor",
            "docs",
            "flaky-test",
            "test-defect",
            "ci",
            "dependency",
            "release",
            "order",
            "follow-up",
            null
          ]
        },
        "entryFlags": {
          "type": "array",
          "items": {
            "enum": [
              "repro",
              "cause",
              "fix",
              "expect",
              "decision",
              "upstream",
              "bundle",
              "vague",
              "last-good",
              "env",
              "intermittent",
              "trace",
              "bot",
              "measured",
              "stale"
            ]
          }
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "enum": [
              "docs-answerable",
              "known-duplicate",
              "mixed-bundle",
              "human-run",
              "distribution-incident",
              "settled-design",
              "red-since-change",
              "check-misses",
              "mechanism-inert",
              "removal-requested",
              "visual-open",
              "contradicts-record"
            ]
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "enum": [
              "approved-record-task",
              "grilling-required",
              "decide-by-change-request",
              "disabled-test",
              "flaky-label",
              "backport",
              "release-notes",
              "test-plan",
              "acceptance-bodies"
            ]
          }
        }
      }
    },
    "extraction": {
      "description": "The facts the decision rules read. Alternatives are required at low confidence, allowed at medium and refused at high.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "entryFlags",
        "qualifiers",
        "signals",
        "risks",
        "gate",
        "artifacts",
        "confidence"
      ],
      "properties": {
        "intent": {
          "description": "What the request asks for, or null when it cannot be read.",
          "enum": [
            "question-how",
            "question-why",
            "question-help",
            "question-hosted",
            "no-work",
            "defect",
            "defect-regression",
            "defect-silent",
            "defect-crash",
            "defect-conformance",
            "performance",
            "security",
            "surface-contradiction",
            "model-gap",
            "unenforced",
            "stale-record",
            "feature",
            "design",
            "epic",
            "behaviour-change",
            "deprecation",
            "refactor",
            "docs",
            "flaky-test",
            "test-defect",
            "ci",
            "dependency",
            "release",
            "order",
            "follow-up",
            null
          ]
        },
        "entryFlags": {
          "type": "array",
          "items": {
            "enum": [
              "repro",
              "cause",
              "fix",
              "expect",
              "decision",
              "upstream",
              "bundle",
              "vague",
              "last-good",
              "env",
              "intermittent",
              "trace",
              "bot",
              "measured",
              "stale"
            ]
          }
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "enum": [
              "docs-answerable",
              "known-duplicate",
              "mixed-bundle",
              "human-run",
              "distribution-incident",
              "settled-design",
              "red-since-change",
              "check-misses",
              "mechanism-inert",
              "removal-requested",
              "visual-open",
              "contradicts-record"
            ]
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "enum": [
              "approved-record-task",
              "grilling-required",
              "decide-by-change-request",
              "disabled-test",
              "flaky-label",
              "backport",
              "release-notes",
              "test-plan",
              "acceptance-bodies"
            ]
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "enum": ["security", "data-loss", "silent", "breaking", "upgrade", "performance"]
          }
        },
        "gate": {
          "enum": ["none", "decide", "approve", "external"]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "enum": [
              "code",
              "tests",
              "spec",
              "contract",
              "ui",
              "docs",
              "config",
              "ci",
              "deps",
              "data",
              "release",
              "assistant"
            ]
          }
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/reading"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["confidence"],
            "properties": {
              "confidence": {
                "const": "high"
              }
            }
          },
          "then": {
            "not": {
              "required": ["alternatives"],
              "properties": {
                "alternatives": true
              }
            }
          }
        },
        {
          "if": {
            "required": ["confidence"],
            "properties": {
              "confidence": {
                "const": "low"
              }
            }
          },
          "then": {
            "required": ["alternatives"],
            "properties": {
              "alternatives": true
            }
          }
        }
      ]
    },
    "normativeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": ["request", "flow-id", "contract-id", "path"]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": ["path", "evidence"]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "label", "description", "effect"],
      "properties": {
        "optionId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "$ref": "#/$defs/effect"
        }
      }
    },
    "effect": {
      "enum": ["proceed", "replan", "stop"]
    },
    "question": {
      "description": "A question input. A fact question carries no recommendation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {
          "enum": ["decision", "fact"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "$ref": "#/$defs/effect"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "fact"
          }
        }
      },
      "then": {
        "not": {
          "required": ["recommendation"],
          "properties": {
            "recommendation": true
          }
        }
      }
    }
  }
}
