{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qfai:workflow:stage-result",
  "title": "Stage result",
  "description": "The result of one work order, as accept takes it. A routing result also carries the proposal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resultId",
    "workOrderId",
    "stageInstanceId",
    "attempt",
    "expectedSequence",
    "outcome",
    "testObservation",
    "actor"
  ],
  "properties": {
    "resultId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "workOrderId": {
      "type": "string",
      "minLength": 1
    },
    "stageInstanceId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "expectedSequence": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "enum": [
        "accepted",
        "accepted_with_debt",
        "needs_repair",
        "awaiting_input",
        "blocked",
        "unrun"
      ]
    },
    "testObservation": {
      "enum": ["pass", "expected_red", "fail", "unrun", "not_applicable"]
    },
    "actor": {
      "description": "The agent instance that produced the result: the author of a stage's work, the recommender of a routing result.",
      "type": "object",
      "additionalProperties": false,
      "required": ["agentInstance"],
      "properties": {
        "agentInstance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      }
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      }
    },
    "gateResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateId", "verdict"],
        "properties": {
          "gateId": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reviewResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "agentInstance", "verdict", "reportRef"],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "agentInstance": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "minLength": 1
          },
          "reportRef": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "debts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/debt"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "urn:qfai:workflow:route-proposal#/$defs/question"
      }
    },
    "notRun": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": {
              "const": "not_applicable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "receiptRef"],
          "properties": {
            "kind": {
              "const": "reused"
            },
            "receiptRef": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "passes": {
      "description": "Each pass-through step that ran and had nothing to write, with its reason and the git-ignored record of what it read.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "reason", "evidenceRef"],
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRef": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "adopted": {
      "description": "Each decision a step took itself rather than put to the operator, and why.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "decision", "reason"],
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "raise": {
      "description": "Each modifier the result raises for the rest of the run, and why. Nothing lowers one.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modifier", "reason"],
        "properties": {
          "modifier": {
            "enum": ["gate:user", "gate:release"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "closure": {
      "description": "How a triage-close result closed the request, and each further request the route found.",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "followUps"],
      "properties": {
        "outcome": {
          "enum": [
            "no-work",
            "other-owner",
            "answered",
            "duplicate",
            "awaiting-info",
            "accepted",
            "declined",
            "deferred",
            "decided",
            "split",
            "handed-off",
            "verified"
          ]
        },
        "followUps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["goal", "reason"],
            "properties": {
              "goal": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "red": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testId", "failureKind"],
      "properties": {
        "testId": {
          "type": "string",
          "minLength": 1
        },
        "failureKind": {
          "enum": ["assertion", "collection", "import", "startup", "timeout"]
        }
      }
    },
    "seam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetTestId", "observation"],
      "properties": {
        "targetTestId": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "seamRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetTestId"],
      "properties": {
        "targetTestId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "testFix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citedBefore", "citedAfter"],
      "properties": {
        "citedBefore": {
          "description": "The BF, AC and EX IDs the test annotates, and a digest of the text of those items and of the rules that cite them.",
          "type": "object",
          "additionalProperties": false,
          "required": ["ids", "digest"],
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "citedAfter": {
          "description": "The BF, AC and EX IDs the test annotates, and a digest of the text of those items and of the rules that cite them.",
          "type": "object",
          "additionalProperties": false,
          "required": ["ids", "digest"],
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reviewRef": {
          "type": "string",
          "minLength": 1
        },
        "rerunRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "regressionFix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testId"],
      "properties": {
        "testId": {
          "type": "string",
          "minLength": 1
        },
        "rerunRef": {
          "type": "string",
          "minLength": 1
        },
        "reviewRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reproductionRef", "matchedIds"],
      "properties": {
        "verdict": {
          "enum": [
            "missing-test",
            "defective-test",
            "regression",
            "expectation-differs",
            "as-specified",
            "not-ours",
            "duplicate",
            "needs-info",
            "surface-conflict",
            "check-gap",
            "product-race"
          ]
        },
        "reproductionRef": {
          "type": "string",
          "minLength": 1
        },
        "matchedIds": {
          "description": "BF, AC or EX IDs of the bound flow; the first decides the next stage.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(BF-\\d{4}|AC-\\d{4}-\\d{4}-\\d{2}|EX-\\d{4}-\\d{4}-\\d{2})$"
          }
        }
      }
    },
    "branch": {
      "description": "What a step at a branch point other than implement-diagnose reports: the outcome, the route it names among several destinations, and the reading the decision rules are given.",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "extraction": {
          "$ref": "urn:qfai:workflow:route-proposal#/$defs/reading"
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slotId", "flowId", "storyIds"],
        "properties": {
          "slotId": {
            "type": "string",
            "minLength": 1
          },
          "flowId": {
            "type": "string",
            "pattern": "^BF-\\d{4}$"
          },
          "storyIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^US-\\d{4}-\\d{4}$"
            }
          }
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "attempt"],
      "properties": {
        "status": {
          "enum": ["saturated", "unavailable"]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "measurement": {
      "description": "Each field a number, or null where the host exposes nothing; never 0 in its place.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "cachedTokens",
        "subAgentTokens",
        "toolDefinitionBytes",
        "referenceBytesRead",
        "wallClockMs",
        "questionsPut",
        "reworkCount"
      ],
      "properties": {
        "inputTokens": {
          "type": ["number", "null"]
        },
        "outputTokens": {
          "type": ["number", "null"]
        },
        "cachedTokens": {
          "type": ["number", "null"]
        },
        "subAgentTokens": {
          "type": ["number", "null"]
        },
        "toolDefinitionBytes": {
          "type": ["number", "null"]
        },
        "referenceBytesRead": {
          "type": ["number", "null"]
        },
        "wallClockMs": {
          "type": ["number", "null"]
        },
        "questionsPut": {
          "type": ["number", "null"]
        },
        "reworkCount": {
          "type": ["number", "null"]
        }
      }
    },
    "proposal": {
      "$ref": "urn:qfai:workflow:route-proposal"
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "debt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingCode",
        "path",
        "cause",
        "owningFlow",
        "detectingCommand",
        "resolvingOwner",
        "blockingExtent"
      ],
      "properties": {
        "findingCode": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "type": "string",
          "minLength": 1
        },
        "owningFlow": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "detectingCommand": {
          "type": "string",
          "minLength": 1
        },
        "resolvingOwner": {
          "type": "string",
          "minLength": 1
        },
        "blockingExtent": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
