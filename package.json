{
  "name": "qfai",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aganesy/QFAI.git"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "pnpm -C packages/qfai build",
    "ci:local": "pnpm format:check && pnpm lint && pnpm lint:md && pnpm check-types && pnpm check-types:future && node ./scripts/check-bidi.mjs && node ./scripts/check-build-warnings.mjs && pnpm -C packages/qfai test && pnpm verify:pack",
    "lint": "eslint . --max-warnings 0",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "check-types": "tsc -b",
    "check-types:future": "node ./scripts/check-types-future.mjs",
    "test:assets": "pnpm -C packages/qfai test:assets",
    "verify:pack": "node ./scripts/verify-pack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/node": "^18.19.41",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli2": "0.17.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-future": "npm:typescript@6.0.1-rc",
    "typescript-eslint": "^8.5.0"
  }
}
