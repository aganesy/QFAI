{
  "name": "qfai-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aganesy/QFAI.git"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "preinstall": "node ./scripts/check-not-a-dependency.mjs",
    "bootstrap": "node ./scripts/bootstrap.mjs",
    "graph:prepare": "node ./scripts/prepare-graph-tools.mjs",
    "build": "node ./scripts/run-package-build.mjs",
    "sync:ssot": "node ./scripts/link-assistant-tree.mjs && node ./scripts/sync-init-to-root.mjs && node ./scripts/gen-codex-agents.mjs",
    "ci:gate": "pnpm ci:gate:checks && pnpm -C packages/qfai test",
    "ci:gate:checks": "pnpm ci:gate:ssot && pnpm ci:gate:lint && pnpm ci:gate:types && pnpm ci:gate:build",
    "ci:gate:ssot": "pnpm sync:ssot && git diff --exit-code .qfai/ qfai.config.yaml packages/qfai/assets/init/.qfai/",
    "ci:gate:lint": "bash ./scripts/run-lint-checks.sh gate",
    "ci:gate:types": "pnpm check-types",
    "ci:gate:build": "node ./scripts/check-build-warnings.mjs && pnpm verify:pack",
    "ci:gate:structure": "bash ./scripts/run-aggregate-checks.sh gate:structure",
    "ci:gate:scans": "bash ./scripts/run-aggregate-checks.sh gate:scans",
    "ci:lint": "node ./scripts/check-workflow-hygiene.mjs && bash ./scripts/run-lint-checks.sh",
    "ci:lint:structure": "bash ./scripts/run-aggregate-checks.sh lint:structure",
    "ci:lint:scans": "bash ./scripts/run-aggregate-checks.sh lint:scans",
    "ci:build-verify": "node ./scripts/check-build-warnings.mjs && pnpm verify:pack && node ./scripts/check-publish-dry-run.mjs",
    "sync:mdschema": "node scripts/sync-mdschema-version.mjs",
    "branch:catchup": "node scripts/branch-catchup.mjs",
    "pins:reseal": "node ./scripts/pin-guard-bytes.mjs && node ./scripts/pin-verification-bodies.mjs",
    "pins:entry": "node ./scripts/regen-shipped-entry.mjs",
    "footprint:pin": "node ./scripts/pin-always-loaded-footprint.mjs",
    "lint": "node --max-old-space-size=8192 ./node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:mermaid": "node ./scripts/check-mermaid.mjs",
    "lint:mdschema": "node ./scripts/check-mdschema.mjs --scope all",
    "lint:doc-clarity": "node ./scripts/check-doc-clarity.mjs",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "check-types": "node ./scripts/check-tsc-compiler.mjs && node ./scripts/check-test-enumeration.mjs && node ./node_modules/typescript/bin/tsc -b && node ./node_modules/typescript/bin/tsc -p packages/qfai/tsconfig.tests.json",
    "check-types:future": "node ./scripts/check-types-future.mjs",
    "test:assets": "pnpm -C packages/qfai test:assets",
    "verify:pack": "node ./scripts/verify-pack.mjs",
    "prepack": "echo 'ERROR: Do not pack from repo root. Use packages/qfai/' && exit 1"
  },
  "devDependencies": {
    "@asamuzakjp/css-color": "4.1.2",
    "@eslint/js": "^10.0.1",
    "@jackchuka/mdschema": "0.16.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "0.22.1",
    "mermaid": "11.17.2",
    "prettier": "^3.3.3",
    "qfai": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "typescript-future": "npm:typescript@7.0.2"
  }
}
