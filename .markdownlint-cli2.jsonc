{
  "config": {
    "default": true,
    "MD013": {
      "line_length": 200,
      "tables": false,
    },
    "MD029": {
      "style": "ordered",
    },
    "MD033": {
      "allowed_elements": [
        "br",
        "details",
        "summary",
        "sub",
        "sup",
        "img",
        "a",
        "role",
        "task",
        "refs",
      ],
    },
    "MD041": true,
  },
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "tmp/**",
    "CHANGELOG.md",
    ".git/**",
    ".instruction/**",
    ".serena/**",
    ".claude/commands/**",
    ".github/prompts/**",
    ".qfai/discussion/**",
    ".qfai/archive/**",
    ".qfai/discussion_archive/**",
    ".qfai/review_archive/**",
    ".qfai/assistant/agents/**",
    ".qfai/assistant/skills/*/references/**",
    ".qfai/assistant/skills/*/templates/**",
    ".qfai/assistant/skills/qfai-*/SKILL.md",
    ".qfai/assistant/skills.local/**",
    ".qfai/assistant/steering/**",
    ".qfai/contracts/**",
    ".qfai/evidence/*[0-9]*.md",
    ".qfai/report/atdd-traceability/**",
    ".qfai/report/preflight_summary.md",
    ".qfai/report/run-*/**",
    ".qfai/report/specs-coverage/**",
    ".qfai/report/validate.json",
    ".qfai/report/validate.log",
    ".qfai/report/report.md",
    ".qfai/review/review-*/**",
    // Repo-root `review/` (note: different from `.qfai/review/` above) is
    // where local review packs from ad-hoc runs land before they are moved
    // under `.qfai/review/`. The content is provider-generated reviewer
    // notes and summary.json which destabilises MD032/MD036/MD013 without
    // improving authored-source quality. If a future repo-root `review/`
    // pattern needs to be linted, move the authored files under a separate
    // subdirectory that is not matched by this glob.
    "review/**",
    ".agents/skills/qfai-*",
    ".agents/skills/qfai-*/**",
    ".claude/skills/qfai-*",
    ".claude/skills/qfai-*/**",
    ".codex/skills/qfai-*",
    ".codex/skills/qfai-*/**",
    ".github/skills/qfai-*",
    ".github/skills/qfai-*/**",
    "packages/qfai/assets/**",
    "packages/qfai/.claude/**",
    "packages/qfai/.qfai/**",
    "packages/qfai/tests/fixtures/**",
  ],
}
