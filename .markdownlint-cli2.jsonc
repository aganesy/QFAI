{
  "config": {
    "default": true,
    "MD013": {
      "line_length": 200,
      "tables": false,
    },
    "MD029": {
      "style": "ordered",
    },
    "MD033": {
      "allowed_elements": [
        "br",
        "details",
        "summary",
        "sub",
        "sup",
        "img",
        "a",
        "role",
        "task",
        "refs",
      ],
    },
    "MD041": true,
  },
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "tmp/**",
    // Git worktrees of other branches. Linted here, their findings are reported
    // against this checkout.
    ".claude/worktrees/**",
    "CHANGELOG.md",
    ".git/**",
    ".instruction/**",
    ".serena/**",
    ".claude/commands/**",
    // Git worktrees: another branch's checkout, on disk and outside this tree.
    // Linted from here, every finding in that branch is reported against this
    // one, and the same commit passes in CI — which clones fresh and has no
    // worktrees — while failing locally.
    ".claude/worktrees/**",
    ".github/prompts/**",
    ".qfai/discussion/**",
    ".qfai/archive/**",
    ".qfai/discussion_archive/**",
    ".qfai/review_archive/**",
    ".qfai/review/_archive/**",
    ".qfai/assistant/**",
    ".qfai/contracts/**",
    // The migration archive keeps exact historical text. The decision ledger
    // keeps long provenance cells whose formatter padding obscures the record.
    ".qfai/evidence/migration-spec-to-story/**",
    ".qfai/spec/decisions.md",
    ".qfai/evidence/*[0-9]*.md",
    ".qfai/report/atdd-traceability/**",
    ".qfai/report/preflight_summary.md",
    ".qfai/report/preflight/**",
    ".qfai/report/run-*/**",
    ".qfai/report/specs-coverage/**",
    ".qfai/report/spec-coverage/**",
    ".qfai/report/validate.json",
    ".qfai/report/validate.log",
    ".qfai/report/report.md",
    ".qfai/review/review-*/**",
    ".agents/skills/qfai-*",
    ".agents/skills/qfai-*/**",
    ".claude/skills/qfai-*",
    ".claude/skills/qfai-*/**",
    ".codex/skills/qfai-*",
    ".codex/skills/qfai-*/**",
    ".github/skills/qfai-*",
    ".github/skills/qfai-*/**",
    "packages/qfai/assets/**",
    "packages/qfai/.claude/**",
    "packages/qfai/.qfai/**",
    "packages/qfai/tests/fixtures/**",
  ],
}
