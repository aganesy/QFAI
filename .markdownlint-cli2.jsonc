{
  "config": {
    "default": true,
    "MD013": {
      "line_length": 200,
      "tables": false,
    },
    "MD029": {
      "style": "ordered",
    },
    "MD033": {
      "allowed_elements": [
        "br",
        "details",
        "summary",
        "sub",
        "sup",
        "img",
        "a",
        "role",
        "task",
        "refs",
        "spec-id",
        "spec-id-or-name",
      ],
    },
    "MD041": true,
  },
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "tmp/**",
    "CHANGELOG.md",
    ".git/**",
    ".instruction/**",
    ".serena/**",
    ".claude/commands/**",
    ".github/prompts/**",
    ".qfai/assistant/agents/**",
    ".qfai/assistant/skills/*/references/**",
    ".qfai/assistant/skills/*/templates/**",
    ".qfai/assistant/skills.local/**",
    ".qfai/evidence/**",
    ".qfai/report/**",
    ".qfai/review/**",
    "packages/qfai/assets/**",
    "packages/qfai/.claude/**",
    "packages/qfai/.qfai/**",
    "packages/qfai/tests/fixtures/**",
  ],
}
