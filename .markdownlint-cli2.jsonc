{
  "config": {
    "default": true,
    "MD013": {
      "line_length": 200,
      "tables": false,
    },
    "MD029": {
      "style": "ordered",
    },
    "MD033": {
      "allowed_elements": [
        "br",
        "details",
        "summary",
        "sub",
        "sup",
        "img",
        "a",
        "role",
        "task",
        "refs",
      ],
    },
    "MD041": true,
  },
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "tmp/**",
    "CHANGELOG.md",
    ".git/**",
    ".instruction/**",
    ".serena/**",
    ".claude/commands/**",
    ".github/prompts/**",
    ".qfai/discussion/**",
    ".qfai/archive/**",
    ".qfai/discussion_archive/**",
    ".qfai/review_archive/**",
    ".qfai/assistant/agents/**",
    ".qfai/assistant/skills/*/references/**",
    ".qfai/assistant/skills/*/templates/**",
    ".qfai/assistant/skills/qfai-*/SKILL.md",
    ".qfai/assistant/skills.local/**",
    ".qfai/assistant/steering/**",
    ".qfai/contracts/**",
    ".qfai/evidence/*[0-9]*.md",
    ".qfai/report/atdd-traceability/**",
    ".qfai/report/preflight_summary.md",
    ".qfai/report/run-*/**",
    ".qfai/report/specs-coverage/**",
    ".qfai/report/validate.json",
    ".qfai/report/validate.log",
    ".qfai/report/report.md",
    ".qfai/review/review-*/**",
    // `review/` stores review artifacts pulled in from QFAI runs (append-only
    // reviewer notes, summary.json). These are not authored markdown and can
    // contain provider-generated text that destabilises MD032/MD036/MD013;
    // linting them would flake CI without improving quality of authored
    // sources. Keep the whole tree ignored and lint generated markdown only
    // where it is intentionally authored (e.g. packages/qfai/README.md).
    "review/**",
    ".agents/skills/qfai-*",
    ".agents/skills/qfai-*/**",
    ".claude/skills/qfai-*",
    ".claude/skills/qfai-*/**",
    ".codex/skills/qfai-*",
    ".codex/skills/qfai-*/**",
    ".github/skills/qfai-*",
    ".github/skills/qfai-*/**",
    "packages/qfai/assets/**",
    "packages/qfai/.claude/**",
    "packages/qfai/.qfai/**",
    "packages/qfai/tests/fixtures/**",
  ],
}
