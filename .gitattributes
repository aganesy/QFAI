# Default: do not convert line endings
* text=auto eol=lf

# Keep CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# The two registers every change appends to: a union merge keeps the rows of
# both sides, and `qfai validate` still reports two rows with the same ID.
/.qfai/spec/decisions.md merge=union
/.qfai/spec/open-questions.md merge=union
