# Default: do not convert line endings
* text=auto eol=lf

# Keep CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# New register rows are appended and a row keeps its ID, so the union driver keeps both branches'
# appended rows. A decision row's wording may be restated; when both branches restate one row, the
# driver keeps both versions. GitHub's merge ignores the driver, so a pull request can show a
# conflict a local merge does not: resolve a conflict confined to the registers by merging the base
# branch locally and pushing, changing no row in the merge. `pnpm ci:lint:scans` and
# `pnpm branch:catchup` report two rows left with one ID.
/.qfai/spec/decisions.md merge=union
# Preserve reviewed page bytes; schema and duplicate checks still apply.
/.qfai/spec/decisions/page-*.md -text merge=union
/.qfai/spec/open-questions.md merge=union
