# Default: do not convert line endings
* text=auto eol=lf

# Keep CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Keep both branches' appended register lines; validation still detects duplicate IDs.
/.qfai/spec/decisions.md merge=union
/.qfai/spec/open-questions.md merge=union
